# Copy the values you need into your server's environment (or a process manager config).
# Development needs none of these; defaults are safe for localhost only.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=mbm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mbm.example.com
# DJANGO_ALLOW_SIGNUP=false        # close public sign-up (default: open)
# DJANGO_DB_PATH=/var/lib/mbm/db.sqlite3
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# FRONTEND_DIST=/srv/mbm/frontend/dist
